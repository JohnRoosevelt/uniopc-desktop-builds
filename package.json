{
  "name": "@uniopc/desktop",
  "private": true,
  "version": "0.4.20",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:v2": "vite --mode v2",
    "build": "npm run prepare:bundled-plugins && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build --mode prod",
    "build:v2": "npm run prepare:bundled-plugins && node --max-old-space-size=8192 ./node_modules/vite/bin/vite.js build --mode v2",
    "report:bundle": "npm run build && node scripts/report-frontend-bundle.mjs",
    "preview": "vite preview --mode prod",
    "tauri": "tauri",
    "test": "npm run test:desktop:all",
    "test:js": "npm run test:desktop:js",
    "test:rust": "npm run test:desktop:rust",
    "test:desktop:js": "node scripts/test-desktop.mjs js",
    "test:desktop:rust": "node scripts/test-desktop.mjs rust",
    "test:desktop:smoke:unit": "node scripts/test-desktop.mjs smoke-unit",
    "test:desktop:all": "node scripts/test-desktop.mjs all",
    "test:e2e:tauri": "node scripts/e2e-tauri.mjs",
    "test:e2e:tauri:unit": "node --test scripts/e2e-tauri.test.mjs",
    "tauri:dev": "npm run prepare:bundled-plugins && npm run build:openclaw-runtime -- --unsigned-local && tauri dev",
    "tauri:dev:v2": "npm run prepare:bundled-plugins && npm run build:openclaw-runtime -- --unsigned-local && tauri dev --config src-tauri/tauri.v2.conf.json",
    "tauri:build": "tauri build",
    "build:release": "node scripts/build-desktop-release.mjs",
    "build:validation": "node scripts/build-desktop-validation.mjs",
    "build:openclaw-runtime": "node scripts/build-openclaw-runtime-bundle.mjs",
    "audit:openclaw-plugins": "node scripts/audit-openclaw-plugin.mjs",
    "collect:openclaw-release-matrix": "node scripts/collect-openclaw-release-matrix.mjs",
    "bootstrap:openclaw-release-validation": "node scripts/bootstrap-openclaw-release-validation.mjs",
    "validate:openclaw-release-live": "node scripts/validate-openclaw-release-live.mjs",
    "produce:openclaw-plugin-attestation": "node scripts/audit-openclaw-plugin.mjs --produce-release-attestation",
    "verify:openclaw-plugin-attestation": "node scripts/audit-openclaw-plugin.mjs --verify-release-attestation",
    "verify:openclaw-contract": "node scripts/verify-openclaw-release-contract.mjs",
    "verify:whitelabel-runtime": "node scripts/verify-uniopc-whitelabel-runtime.mjs",
    "prepare:updater-release": "node scripts/prepare-desktop-updater-release.mjs",
    "release:updater": "node scripts/release-desktop-updater.mjs",
    "prepare:bundled-plugins": "node scripts/prepare-bundled-plugin-dependencies.mjs"
  },
  "dependencies": {
    "@blocksuite/blocks": "0.19.5",
    "@blocksuite/icons": "2.2.17",
    "@blocksuite/presets": "0.19.5",
    "@blocksuite/store": "0.19.5",
    "@supabase/supabase-js": "^2.89.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.4.1",
    "@tauri-apps/plugin-http": "^2.5.8",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.2",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "highlight.js": "^11.11.1",
    "i18next": "^25.8.14",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.1",
    "remark-gfm": "^4.0.1",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.0",
    "@babel/traverse": "^7.29.0",
    "@openclaw/plugin-inspector": "0.3.24",
    "@tailwindcss/vite": "^4.2.1",
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vanilla-extract/vite-plugin": "^5.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "esbuild": "0.27.7",
    "postcss-nesting": "^14.0.1",
    "pptxgenjs": "4.0.1",
    "tailwindcss": "^4.2.1",
    "tar": "7.5.22",
    "vite": "^7.3.1"
  }
}
