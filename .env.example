VITE_SUPABASE_URL=https://api.imai.app
VITE_SUPABASE_ANON_KEY=sb_publishable_key_for_local_development
VITE_PLUGINS_SUPABASE_URL=https://plugins.example.com
VITE_PLUGINS_SUPABASE_ANON_KEY=sb_publishable_key_for_plugins
# Smart Montage is a desktop-native client of uniopc-funcs. These values are
# public service origins only; do not put a service bearer credential in Vite.
VITE_COPYWRITING_API_URL=https://uniopc-ywriting-apoxivoeyq.cn-hangzhou.fcapp.run
VITE_VIDEO_CLIPS_API_URL=https://uniopc-eo-clips-aiwlkdpyyi.cn-hangzhou.fcapp.run/api/v1
# Required while the FC HTTP triggers use Bearer authentication. Keep the
# actual values in ignored .env.dev / .env.prod files, never in this template.
VITE_COPYWRITING_BEARER_TOKEN=
VITE_VIDEO_CLIPS_BEARER_TOKEN=
