{
  "name": "@uniopc/openclaw-local-workspace-plugin",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Expose local Uniopc desktop documents as fixed-schema Markdown tools.",
  "main": "dist/index.js",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "files": [
    "dist",
    "uniopc.plugin.json",
    "plugin.json",
    "resources",
    "skills"
  ],
  "devDependencies": {
    "openclaw": "2026.8.1",
    "typescript": "5.9.3"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "minHostVersion": ">=2026.8.1"
    },
    "compat": {
      "pluginApi": ">=2026.8.1"
    },
    "build": {
      "openclawVersion": "2026.8.1",
      "pluginSdkVersion": "2026.8.1"
    }
  }
}
