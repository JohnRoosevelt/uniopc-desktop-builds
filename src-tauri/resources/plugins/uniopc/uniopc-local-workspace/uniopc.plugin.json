{
  "id": "uniopc-local-workspace",
  "name": "本地工作区",
  "version": "0.1.3",
  "description": "Expose local Uniopc desktop documents through an authenticated loopback bridge.",
  "userManagedCredentials": false,
  "requiredEnv": [
    "UNIOPC_LOCAL_DOCUMENTS_URL",
    "UNIOPC_LOCAL_DOCUMENTS_TOKEN",
    "UNIOPC_OPENCLAW_PROFILE"
  ],
  "configSchema": {
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "uniopc_local_documents_list",
      "uniopc_local_document_get",
      "uniopc_local_document_create",
      "uniopc_local_document_update"
    ]
  },
  "toolMetadata": {
    "uniopc_local_documents_list": {
      "replaySafe": true,
      "sideEffecting": false
    },
    "uniopc_local_document_get": {
      "replaySafe": true,
      "sideEffecting": false
    },
    "uniopc_local_document_create": {
      "replaySafe": false,
      "sideEffecting": true
    },
    "uniopc_local_document_update": {
      "replaySafe": false,
      "sideEffecting": true
    }
  }
}
